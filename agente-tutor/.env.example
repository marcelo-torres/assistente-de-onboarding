# Chave de API do Google Gemini / Google AI Studio
GOOGLE_GENAI_API_KEY=sua_chave_aqui

# Modelo padrão do Google ADK para o Tutor
TUTOR_MODEL=gemini-2.5-flash

# Configurações do Agente de Base de Conhecimento (A2A)
# URL onde o Agent Card do subagente de conhecimento é servido
KNOWLEDGE_AGENT_CARD_URL=http://localhost:8001/.well-known/agent-card.json

# Fallback para modo mock quando o agente de conhecimento não estiver rodando
KNOWLEDGE_AGENT_MOCK_FALLBACK=true

# Porta do servidor mock do Knowledge Agent
MOCK_KB_PORT=8001

# Configurações de execução
DEBUG=true
